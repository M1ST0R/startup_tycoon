# Скопируйте этот файл в .env и при необходимости измените значения.
# Файл .env нельзя коммитить (он указан в .gitignore).

# development | production
NODE_ENV=development

# Адрес и порт сервера. По умолчанию слушаем только localhost.
HOST=127.0.0.1
PORT=3000

# Путь к файлу SQLite (папка создаётся автоматически)
DB_PATH=./data/game.db

# Срок жизни сессии в днях
SESSION_DAYS=7

# Secure-cookie: по умолчанию true в production и false иначе.
# Если сайт открыт по HTTPS, оставьте true. Задавайте явно только при необходимости.
# COOKIE_SECURE=true

# Сколько прокси стоит перед сервером (нужно для правильного IP в ограничении частоты запросов).
# Для прямого запуска оставьте 0, за одним nginx/Caddy поставьте 1.
TRUST_PROXY=0
